# For docker compose. Copy to .env and fill in. Never commit the real .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
APP_URL=http://localhost:8080
# false = empty database with one admin; true = demo data (never in real production)
DEMO_DATA=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Background jobs: email delivery and daily automatic billing (bills after BILLING_HOUR, local time)
SCHEDULER_ENABLED=true
AUTO_BILLING=true
BILLING_HOUR=8
