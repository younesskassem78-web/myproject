# Copy to .env and fill in. Never commit the real .env.

# PostgreSQL connection (use 127.0.0.1, not localhost, on Windows: it avoids a slow IPv6 retry)
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5433/myterra
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5433/myterra_test

# development | production (production hides /docs)
APP_ENV=development
# Website address used in email links
APP_URL=http://localhost:4200
# Comma-separated origins allowed to call the API directly (not needed when nginx serves both)
CORS_ORIGINS=http://localhost:4200

# true = demo plans, customers and bills (development). false = empty database with one admin from below.
DEMO_DATA=true
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: real email through Gmail (needs 2-Step Verification and an app password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: real SMS through Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional tuning
DB_POOL_SIZE=10

# Browser (Playwright) tests: a throwaway database that is wiped before every run. Name must end in _e2e.
E2E_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5433/myterra_e2e
